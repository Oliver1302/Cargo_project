PORT=4000

# Postgres
DATABASE_URL=postgresql://postgres:deltar@localhost:5432/logistics

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Google Maps (optional — geocoding/map features degrade gracefully without it)
GOOGLE_MAPS_API_KEY=

# WhatsApp notifications (Twilio) — logged to console instead of sent if empty
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
ADMIN_WHATSAPP_NUMBER=+254798409150

# SMS notifications (Africa's Talking) — logged to console instead of sent if empty
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Email notifications (Resend) — logged to console instead of sent if empty
RESEND_API_KEY=
RESEND_FROM_EMAIL=Freightly <onboarding@resend.dev>

# M-Pesa (Safaricom Daraja) — placeholder until you have a paybill/till + API credentials
MPESA_CONSUMER_KEY=
MPESA_PAYBILL_NUMBER=

# AI dispatch suggestions (Claude/Anthropic) — falls back to rule-based suggestion if empty
ANTHROPIC_API_KEY=

# Frontend origins allowed to call this API
ADMIN_ORIGIN=http://localhost:5173
PORTAL_ORIGIN=http://localhost:5174
LANDING_ORIGIN=http://localhost:5175

LANDING_ORIGIN=https://your-landing-vercel-url.vercel.app
